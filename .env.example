# Melody: пример настроек. Скопируйте файл в .env и заполните значения.
# Файл .env содержит секреты. Его нельзя коммитить в репозиторий: он уже указан в .gitignore.

# ── Обязательные ───────────────────────────────────────────────────────────
# Токен бота: Developer Portal → Bot → Reset Token. Никому не передавайте его.
DISCORD_TOKEN=
# Client ID приложения: Developer Portal → General Information → Application ID.
DISCORD_CLIENT_ID=

# ── Discord ────────────────────────────────────────────────────────────────
# ID сервера для разработки. С ним команды появляются сразу. Без него команды глобальные
# и могут появиться в течение часа.
DISCORD_GUILD_ID=
# Название бота в панели и подсказках.
BOT_NAME=Melody
# Уровень журнала: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# ── Файлы и данные ─────────────────────────────────────────────────────────
# База SQLite с настройками серверов, историей и каталогом библиотеки.
DATABASE_PATH=data/melody.sqlite
# Файл состояния для проверки работоспособности (его читает healthcheck).
HEALTH_FILE=data/health.json
# Каталог с локальной музыкой.
MUSIC_DIR=music
# Периодическое пересканирование каталога в минутах. 0 отключает пересканирование.
MUSIC_RESCAN_MINUTES=60

# ── FFmpeg ─────────────────────────────────────────────────────────────────
# Пути к программам. Укажите полный путь, если их нет в PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Воспроизведение ────────────────────────────────────────────────────────
# Максимум треков в очереди сервера (1–500).
MAX_QUEUE_SIZE=100
# Максимальная длительность одного трека в секундах (60–21600).
MAX_TRACK_DURATION_SEC=1800
# Громкость по умолчанию в процентах (0–100).
DEFAULT_VOLUME=70
# Через сколько секунд тишины бот покидает канал, когда ничего не играет (10–3600).
IDLE_TIMEOUT_SEC=300
# Через сколько секунд бот покидает канал, в котором никого нет (10–600).
EMPTY_CHANNEL_TIMEOUT_SEC=60
# Сколько команд пользователь может отправить за 10 секунд (1–60).
RATE_LIMIT_PER_10S=6

# ── Потоковые источники (каталог оператора) ────────────────────────────────
# Выключено по умолчанию. Включите только для потоков, на которые у вас есть права.
STREAM_PROVIDER_ENABLED=false
STREAM_CATALOG_FILE=config/streams.json
# Лимит байт для конечных потоков (от 1 МиБ до 4 ГиБ).
STREAM_MAX_BYTES=536870912

# ── YouTube (экспериментальный, выключен по умолчанию) ─────────────────────
# Перед включением прочитайте docs/youtube.md: условия сервиса и права на контент.
YOUTUBE_PROVIDER_ENABLED=false
# Программа yt-dlp. Нужна только при включённом YouTube.
YTDLP_PATH=yt-dlp
# Среда выполнения для решения задач yt-dlp: node или deno.
YTDLP_JS_RUNTIME=node
YOUTUBE_MAX_DURATION_SEC=900
YOUTUBE_PLAYLIST_MAX_ITEMS=25
YOUTUBE_MAX_CONCURRENCY=2
YOUTUBE_TIMEOUT_SEC=30
